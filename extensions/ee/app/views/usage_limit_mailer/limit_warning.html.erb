<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="en">
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>
      You have used <%= @threshold_percentage %> of your <%=
      @affected_resources %>
    </title>
  </head>
  <body dir="ltr" lang="en" style="background-color:#070514;margin:0;padding:0">
    <!--$--><!--html--><!--head-->
    <div
      style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0"
      data-skip-in-text="true">
      You have used <%= @threshold_percentage %> of your <%=
      @affected_resources %>
      <div>
         ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿
      </div>
    </div>
    <!--body-->
    <table
      border="0"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      align="center">
      <tbody>
        <tr>
          <td
            dir="ltr"
            lang="en"
            style='background-color:#070514;color:#ffffff;font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;margin:0;padding:32px 12px'>
            <table
              align="center"
              width="100%"
              border="0"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="max-width:600px;margin:0 auto;width:100%">
              <tbody>
                <tr style="width:100%">
                  <td>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      style="background-color:#191825;border:1px solid #201e2c;border-radius:24px;text-align:center">
                      <tbody>
                        <tr>
                          <td style="padding:48px 40px">
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation"
                              style="background-color:#302922;border-radius:16px;height:48px;margin:0 auto 20px;width:48px">
                              <tbody>
                                <tr>
                                  <td>
                                    <p
                                      style="font-size:24px;line-height:48px;color:#ffbe0b;font-weight:700;margin:0;text-align:center;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                      ▲
                                    </p>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                            <h1
                              style="color:#ffffff;font-size:28px;font-weight:700;letter-spacing:-0.5px;line-height:36px;margin:0 0 20px">
                              Close to the usage limit
                            </h1>
                            <p
                              style="font-size:16px;line-height:25px;color:#b8b5ca;margin:0 auto 32px;max-width:460px;text-align:left;margin-top:0;margin-right:auto;margin-bottom:32px;margin-left:auto">
                              Hi <%= @user_name %>,<br /><br />You have
                              used <%= @threshold_percentage %> of your
                              <%= @affected_resources %> for the current
                              billing cycle. Nothing is blocked yet - but once
                              the limit is reached, workflows stop being
                              executed and AI generation is refused until the
                              cycle resets.
                            </p>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation"
                              style="background-color:#070514;border:1px solid #201e2c;border-radius:24px">
                              <tbody>
                                <tr>
                                  <td style="padding:8px 20px">
                                    <table
                                      align="center"
                                      width="100%"
                                      border="0"
                                      cellpadding="0"
                                      cellspacing="0"
                                      role="presentation"
                                      style="border-bottom:1px solid #201e2c">
                                      <tbody style="width:100%">
                                        <tr style="width:100%">
                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:left;vertical-align:middle;width:45%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:#9695a0;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                              Account
                                            </p>
                                          </td>
                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:right;vertical-align:middle;width:55%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:#ffffff;font-weight:600;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                              <%= @account_name %>
                                            </p>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    <table
                                      align="center"
                                      width="100%"
                                      border="0"
                                      cellpadding="0"
                                      cellspacing="0"
                                      role="presentation"
                                      style="border-bottom:1px solid #201e2c">
                                      <tbody style="width:100%">
                                        <tr style="width:100%">
                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:left;vertical-align:middle;width:45%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:#9695a0;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                              AI tokens
                                            </p>
                                          </td>
                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:right;vertical-align:middle;width:55%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:#ffffff;font-weight:600;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                              <%= @ai_usage_summary %>
                                            </p>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    <table
                                      align="center"
                                      width="100%"
                                      border="0"
                                      cellpadding="0"
                                      cellspacing="0"
                                      role="presentation"
                                      style="border-bottom:1px solid #201e2c">
                                      <tbody style="width:100%">
                                        <tr style="width:100%">
                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:left;vertical-align:middle;width:45%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:#9695a0;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                              Workflow executions
                                            </p>
                                          </td>
                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:right;vertical-align:middle;width:55%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:#ffffff;font-weight:600;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                              <%= @workflow_usage_summary
                                              %>
                                            </p>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                    <table
                                      align="center"
                                      width="100%"
                                      border="0"
                                      cellpadding="0"
                                      cellspacing="0"
                                      role="presentation">
                                      <tbody style="width:100%">
                                        <tr style="width:100%">
                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:left;vertical-align:middle;width:45%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:#9695a0;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                              Resets on
                                            </p>
                                          </td>
                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:right;vertical-align:middle;width:55%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:#ffbe0b;font-weight:600;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                                              <%= @reset_date %>
                                            </p>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation"
                              style="margin:32px 0 0">
                              <tbody>
                                <tr>
                                  <td>
                                    <a
                                      href="<%= @dashboard_url %>"
                                      style="line-height:24px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#ffffff;border-radius:16px;color:#070514;font-size:16px;font-weight:600;padding:12px 24px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px"
                                      target="_blank"
                                      ><span
                                        ><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18px" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span
                                      ><span
                                        style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px"
                                        >Review usage</span
                                      ><span
                                        ><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span
                                      ></a
                                    >
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                            <p
                              style="font-size:13px;line-height:20px;color:#b8b5ca;margin:24px auto 0;max-width:460px;margin-top:24px;margin-right:auto;margin-bottom:0;margin-left:auto">
                              Upgrading the plan lifts the limit immediately;
                              otherwise the counters clear on their own on the
                              date above.
                            </p>
                            <p
                              style="font-size:13px;line-height:20px;color:#9695a0;margin:16px auto 0;max-width:420px;margin-top:16px;margin-right:auto;margin-bottom:0;margin-left:auto">
                              To raise the limit or to go through the usage with
                              us, contact us at<!-- -->
                              <a
                                href="mailto:<%= @support_email %>"
                                style="color:#ffbe0b;text-decoration-line:none;text-decoration:underline"
                                target="_blank"
                                ><%= @support_email %></a
                              >.
                            </p>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      style="text-align:center">
                      <tbody>
                        <tr>
                          <td style="padding:28px 16px 0">
                            <img
                              alt="<%= @company_name %> logo"
                              height="32"
                              src="https://codezero.build/api/media/file/CodeZero_Logo.png"
                              style="display:block;outline:none;border:none;text-decoration:none;height:32px;margin:0 auto;width:160px"
                              width="160" />
                          </td>
                        </tr>
                      </tbody>
                    </table>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation">
                      <tbody>
                        <tr>
                          <td style="padding:24px 16px 0">
                            <p
                              style="font-size:12px;line-height:19px;color:#9695a0;margin:0;text-align:center;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
                              This is a transactional email about the <%=
                              @company_name %> account for <%= @email
                              %>.<br />©
                              <!-- -->2026<!-- -->
                              <!-- --><%= @legal_name %>
                            </p>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
    <!--/$-->
  </body>
</html>
