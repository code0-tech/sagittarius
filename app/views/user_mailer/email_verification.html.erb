                                          <td
                                            data-id="__react-email-column"
                                            style="padding:12px 0;text-align:right;vertical-align:middle;width:55%">
                                            <p
                                              style="font-size:14px;line-height:20px;color:oklch(1 0 0);font-weight:600;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">
